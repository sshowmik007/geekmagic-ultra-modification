# IP address of your SmallTV-Ultra device on your local Wi-Fi network (e.g. 192.168.0.82)
SMALLTV_IP=

# Local dashboard API proxy target (automatically uses SMALLTV_IP if omitted)
SMALLTV_DEVICE_URL=

# Provider mode: "auto" (rotates among active agents), "gemini", "codex", "opencode", "claude"
SMALLTV_PROVIDER_MODE=auto

# Interval in seconds to push live telemetry to the SmallTV display (default: 10)
SMALLTV_PUSH_INTERVAL_SEC=10

# Inactivity threshold in seconds before an agent is marked [IDLE] (default: 90)
SMALLTV_FRESHNESS_TIMEOUT_SEC=90

# Cryptographically generated bridge token (generated by companion/setup_windows.ps1)
SMALLTV_BRIDGE_TOKEN=

# Optional: Antigravity Hub port and CSRF token for live Gemini quota limits
# (Auto-detected on Windows host, or set manually for remote/Docker environments)
SMALLTV_ANTIGRAVITY_HUB_PORT=
SMALLTV_ANTIGRAVITY_CSRF_TOKEN=

# Optional path overrides for local-file scanning compose override (docker-compose.local-files.yml)
# CODEX_HOME=C:/Users/YourName/.codex
# GEMINI_HOME=C:/Users/YourName/.gemini
# CLAUDE_HOME=C:/Users/YourName/.claude
# OPENCODE_HOME=C:/Users/YourName/.local/share/opencode
